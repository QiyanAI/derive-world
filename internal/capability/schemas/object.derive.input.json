{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derive.world/schemas/capability/object.derive.input.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_id", "inheritance_fields", "title"],
  "properties": {
    "object_id": { "$ref": "#/$defs/object_id" },
    "source_version": { "type": "integer", "minimum": 1 },
    "inheritance_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["summary", "body", "checklist", "tags", "prompt", "options"] }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "$defs": {
    "object_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
