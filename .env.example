# Derive World — local development example. Copy to .env.
# Every value below is development-only. Do not use these secrets in production.
# Generate real secrets with: openssl rand -base64 32

APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8080
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://derive:dw_local_only@127.0.0.1:5432/derive_world?sslmode=disable
WEB_DIST_DIR=./web/dist

# Development-only placeholders (>=32 bytes). Production rejects the dw_dev_only_ prefix.
CURSOR_HMAC_SECRET=dw_dev_only_cursor_hmac_secret_change_me_0001
IP_HASH_PEPPER=dw_dev_only_ip_hash_pepper_change_me_00000001
CAPABILITY_HMAC_SECRET=dw_dev_only_capability_hmac_secret_change_me_01
# Key identifier sent with each signed Provider request. Change both this and
# the Provider's CAPABILITY_HMAC_KEY_ID together when rotating.
CAPABILITY_HMAC_KEY_ID=k1
CAPABILITIES_CONFIG=./capabilities.yaml

MODEL_MODE=fixture
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT=60s
# Path appended to MODEL_BASE_URL. The default is the generic
# OpenAI-compatible path; a provider that documents a different path can set
# it without a code change (for example /chat/completions).
MODEL_CHAT_PATH=/v1/chat/completions
# Optional provider capability: request JSON-object output. Empty by default;
# the only accepted non-empty value is json_object.
MODEL_RESPONSE_FORMAT=
# Optional provider capability: disable a default reasoning mode. Empty by
# default; values are empty, default, or disabled. It is sent only when
# explicitly enabled and never required of other providers.
MODEL_THINKING_MODE=
# Output-token ceiling per call (1..8192).
MODEL_MAX_OUTPUT_TOKENS=2048
# Per-call input ceiling in Unicode characters (1024..65536).
MODEL_MAX_INPUT_CHARS=65536
# Per-user UTC-day budget.
MODEL_DAILY_CALLS_PER_USER=100
MODEL_DAILY_INPUT_CHARS_PER_USER=200000
MODEL_CONCURRENCY_PER_USER=2
# Deployment-wide UTC-day call budget. 0 means unlimited in fixture mode; a
# real-mode deployment substitutes 200 when this is unset or 0, and uses an
# explicit positive value as-is.
MODEL_GLOBAL_DAILY_CALLS=0
# Deployment-wide UTC-day input-character budget. 0 means unlimited.
MODEL_GLOBAL_DAILY_INPUT_CHARS=0
# Operator stop switch: true refuses every model call before any provider
# request. Keep false for normal operation.
MODEL_KILL_SWITCH=false
AI_INCLUDE_PRIVATE_CONTEXT=true

CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info
LOG_FORMAT=json
TRUST_PROXY_HEADERS=false

RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_CAPABILITY_PER_HOUR=60
SESSION_ABSOLUTE_TTL=168h
SESSION_IDLE_TTL=24h
MAX_REQUEST_BYTES=1048576
AUDIT_RETENTION_DAYS=90
CLEANUP_INTERVAL=1h
SHUTDOWN_TIMEOUT=15s

# AI-OPS only (not read by the application server).
GITHUB_REPO=QiyanAI/derive-world
METRICS_TOKEN=
