# Example only. Do not treat as a production configuration.
# Set PUBLIC_BASE_URL=https://derive.example.com and TRUST_PROXY_HEADERS=true.
derive.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
